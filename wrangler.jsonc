{
    "$schema": "node_modules/wrangler/config-schema.json",
    "account_id": "0ce2869905292483d658d486a6e31a3c",
    "name": "saas",
    "main": "./worker-entrypoint.ts",
    "preview_urls": true,
    "routes": [
      {
        "pattern": "saas.3webweb.com",
        "custom_domain": true
      }
    ],
    "compatibility_date": "2026-08-03",
    // `global_fetch_strictly_public` is required by the OAuth provider's CIMD support: client_id
    // metadata documents are fetched from the public internet, never looped back into this Worker.
    "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
    "assets": {
      "directory": "dist/client",
      "binding": "ASSETS",
      "not_found_handling": "none"
    },
    "images": {
      "binding": "IMAGES"
    },
    "cache": {
      "enabled": true,
    },
    "observability": {
      "enabled": true,
      "logs": {
        "enabled": true
      },
      "traces": {
        "enabled": true,
        "head_sampling_rate": 0.1,
      }
    },
    "upload_source_maps": true,
    // A render makes several sequential D1 and KV round trips, so the trips cost more than the
    // first hop from the user. Smart Placement runs the Worker near the D1 primary instead.
    "placement": { "mode": "smart" },
    "triggers": {
      "crons": ["*/5 * * * *"]
    },
    "queues": {
      "producers": [
        {
          "binding": "SCHEDULER_QUEUE",
          "queue": "saas-scheduler"
        }
      ],
      "consumers": [
        {
          "queue": "saas-scheduler",
          "max_batch_size": 20,
          "max_batch_timeout": 5,
          "max_retries": 5,
          "retry_delay": 60
        }
      ]
    },


    "ai": {
      "binding": "AI"
    },
    "vars": {
        "APP_TEST_MODE": "false",
        // Keep equal to `account_id`. The runtime cannot read that field, and without this var the
        // zone lookup fails, so the CMS publish never purges stored HTML in other data centers.
        "CLOUDFLARE_ACCOUNT_ID": "0ce2869905292483d658d486a6e31a3c",
        // Admin icon picker only; a fork that self-hosts Iconify changes this one value.
        "ICONIFY_API_ORIGIN": "https://api.iconify.design",
        // Email Sending (the `send_email` binding) needs the Workers Paid plan, so this deployment
        // omits the binding and no transactional email is sent; see src/utils/email.tsx. These
        // vars stay so a paid-plan fork only has to re-add the binding. A fork on any plan can
        // also set EMAIL_PROVIDER to "smtp" and send through QQ Mail et al. over implicit TLS
        // (docs/email-providers.md); the SMTP credentials are secrets, not vars.
        "EMAIL_PROVIDER": "smtp",
        "EMAIL_FROM": "1610269763@qq.com",
        "EMAIL_FROM_NAME": "SaaS Template",
        "EMAIL_REPLY_TO": "1610269763@qq.com"
    },
    "d1_databases": [
        {
            "binding": "D1_DB",
            "database_name": "saas-db",
            "database_id": "db4b99e8-3d09-45a3-a760-abfc7182b969",
            "migrations_dir": "src/db/migrations",
            "migrations_pattern": "src/db/migrations/*/migration.sql"
        }
    ],
    "kv_namespaces": [
        {
            "binding": "KV_STORE",
            "id": "beee087c0fa74b33a0ec7724ef12b5d2"
        },
        // Second binding onto the SAME namespace: @cloudflare/workers-oauth-provider hardcodes the
        // `OAUTH_KV` binding name, and forking the template must not require provisioning anything
        // extra. Its keys are prefix-scoped (see OAUTH_RESERVED_KV_PREFIXES in src/constants.ts);
        // re-audit those prefixes whenever the library is upgraded.
        {
            "binding": "OAUTH_KV",
            "id": "beee087c0fa74b33a0ec7724ef12b5d2"
        }
    ],
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": ["DOQueueHandler"]
        },
        {
            "tag": "v2",
            "deleted_classes": ["DOQueueHandler"]
        }
    ],
    "r2_buckets": [
        {
            "binding": "R2_BUCKET",
            "bucket_name": "saas-media"
        }
    ]
  }

## Cloudflare account/API access
## GitHub Actions deploys with this token, so that one needs edit access to every binding.
## The Worker runtime uses it for two admin features only, and needs just these scopes:
##   Zone:Cache Purge:Purge       - admin "Purge Cloudflare CDN Cache" + the CMS publish tag purge
##   Account:Workers Scripts:Read - the zone lookup behind those purges; drop it by setting
##                                  CLOUDFLARE_ZONE_ID below
##   Account:Queues:Edit          - admin scheduled jobs Queue payload preview. Read is NOT enough:
##                                  Cloudflare puts the message endpoints behind Edit and 403s
## Queue backlog metrics use the SCHEDULER_QUEUE binding, not this token.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional. The admin CDN purge resolves the zone from the Workers domain of SITE_DOMAIN.
# Set this to skip that lookup (and drop the Workers Scripts:Read scope), or to override it
# when the site runs on a different zone.
CLOUDFLARE_ZONE_ID=

## Github Actions Secrets - NOT NECESSARY FOR LOCAL DEV ENVIRONMENT
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional build-time override. `pnpm preview` sets this to http://localhost:8787.
NEXT_PUBLIC_SITE_URL=

# Optional. Raises GitHub REST API rate limits for the stars badge (see src/utils/stats.ts).
GITHUB_TOKEN=

## Cloudflare Worker Secrets
TURNSTILE_SECRET_KEY=

# Transactional email transport. `cloudflare` uses the EMAIL send_email binding (Workers Paid);
# `smtp` sends through any SMTP provider over implicit TLS on port 465 — QQ Mail, 163, Gmail,
# corporate relays — with no extra code. See docs/email-providers.md for per-provider setup.
EMAIL_PROVIDER=cloudflare
# SMTP provider settings. EMAIL_SMTP_USER/PASS are secrets (wrangler secret put, .dev.vars
# locally). For QQ Mail: user is the full address, pass is the 16-char auth code from
# Settings > Account > POP3/SMTP (not the QQ password). EMAIL_FROM must equal EMAIL_SMTP_USER.
EMAIL_SMTP_HOST=smtp.qq.com
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=

# Go to https://console.cloud.google.com/auth/clients/ and create a new OAuth client ID and secret
# Set the redirect URI to http://localhost:3000/sso/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

### Stripe Configuration (team subscription billing)
# Get your API keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret. Local dev: run `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# and copy the printed whsec_... here. Prod: `wrangler secret put STRIPE_WEBHOOK_SECRET`.
STRIPE_WEBHOOK_SECRET=
# Recurring Stripe price IDs per paid plan. Create them with `pnpm stripe:setup`.
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
# Yearly price IDs, only needed when yearly billing is enabled via `yearlyDiscountPercent`
# in src/constants/plans.json. Also created by `pnpm stripe:setup`.
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_ENTERPRISE_YEAR=
# Subscription add-on price IDs, one per entry in src/constants/addons.json:
# STRIPE_PRICE_ADDON_<ID> plus _YEAR when yearly billing is enabled.
# Also created by `pnpm stripe:setup`.
STRIPE_PRICE_ADDON_EXTRA_SEATS=
STRIPE_PRICE_ADDON_EXTRA_SEATS_YEAR=
# Customer portal configuration (payment methods, invoices, business/VAT billing details).
# Created by `pnpm stripe:setup`; when unset, Stripe uses the account's default portal config.
STRIPE_PORTAL_CONFIG_ID=
